# ═══════════════════════════════════════════════════════════════════
# AI Voice Agent Platform — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# 
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit .env to git (contains secrets)
#
# For Render deployment: Set these variables in Render dashboard
# For local development: Create .env file with your values
# ═══════════════════════════════════════════════════════════════════

# ─── API Keys ─────────────────────────────────────────────────────
# Get your Gemini API key from: https://aistudio.google.com/app/apikeys
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Database Configuration ───────────────────────────────────────
# For local development
DATABASE_PATH=./agents.db

# For production (Render persistent disk)
# DATABASE_PATH=/var/data/agents.db

# ─── Vector Database (ChromaDB) ────────────────────────────────────
# Persistent storage location
# Local: ./chroma_db
# Production (Render): /var/data/chroma_db
CHROMA_PERSIST_DIR=./chroma_db

# ─── JWT Authentication ───────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-min-32-chars-change-in-production

# Token expiration settings
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── RAG Configuration (Vector Search) ─────────────────────────────
# Backend selector (switch at runtime for zero-downtime rollback):
#   "chroma"   → ChromaDB with HNSW indexing (RECOMMENDED)
#                Performance: O(log n), <5ms at 2.5K, <100ms at 2.5M
#   "enhanced" → SQL + BM25 + MMR hybrid search
#                Performance: O(n), ~100ms at 10K entries
#   "legacy"   → NumPy-based cosine similarity (DEPRECATED)
#                Performance: O(n), crashes at 100K+ entries
RAG_BACKEND=chroma

# Retrieval tuning parameters:
RAG_TOP_K=5                          # Number of results returned to LLM
RAG_SIMILARITY_THRESHOLD=0.5         # Min similarity score (0.0-1.0)
RAG_ALPHA=0.3                        # Dense search weight (enhanced RAG only)
RAG_MMR_LAMBDA=0.6                   # Diversity factor (0.0-1.0)
MAX_CONTEXT_CHARS=8000               # Max context sent to Gemini

# Chunking strategy:
CHUNK_SIZE=1000                      # Characters per chunk
CHUNK_OVERLAP=200                    # Overlap between chunks

# ─── Server Configuration ──────────────────────────────────────────
# Binding address and port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Development mode
DEBUG=False                          # Set to True for development only

# ─── CORS Origins (comma-separated) ────────────────────────────────
# Local development:
# http://localhost:5173,http://localhost:3000,http://localhost:4173
#
# Production:
# https://your-frontend-url.vercel.app
#
# Widget (any origin):
# * (widgets can embed on any website)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# ─── Environment Detection ────────────────────────────────────────
# Values: development, staging, production
ENVIRONMENT=development

# ─── File Upload Configuration ────────────────────────────────────
# Maximum upload size in MB
MAX_UPLOAD_SIZE=50

# Upload directory
UPLOAD_DIR=./uploads

# ─── Rate Limiting ────────────────────────────────────────────────
# Enable rate limiting
RATE_LIMITING_ENABLED=True

# Requests per minute per company
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ─── Audio Configuration ─────────────────────────────────────────
# Default voice for Gemini TTS
# Options: Puck, Charon, Kore, Fenrir, Aoede
DEFAULT_VOICE=Puck

# Default language
DEFAULT_LANGUAGE=en-US

# ─── Email Configuration (Optional) ───────────────────────────────
# SMTP configuration for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@example.com

# ─── Google Sheets Integration (Optional) ──────────────────────────
# Path to Google service account JSON for Google Sheets sync
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── Feature Flags ────────────────────────────────────────────────
# Enable/disable features
ENABLE_RAG=True
ENABLE_VECTOR_DB=True
ENABLE_GEMINI_LIVE_API=True
ENABLE_WIDGETS=True
ENABLE_ANALYTICS=True

# ─── Logging Configuration ───────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ─── Performance Tuning ───────────────────────────────────────────
# Number of worker processes (for production)
WORKERS=4

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Database connection pool size
DB_POOL_SIZE=5

# Database max overflow
DB_MAX_OVERFLOW=10

# ─── Monitoring (Optional) ────────────────────────────────────────
# Sentry error tracking (optional)
SENTRY_DSN=

# ─── Payments (Optional) ──────────────────────────────────────────
# Stripe integration for billing
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ═══════════════════════════════════════════════════════════════════
# DEPLOYMENT INSTRUCTIONS
# ═══════════════════════════════════════════════════════════════════
#
# For Render.com Deployment:
# 1. Go to Render dashboard
# 2. Click your service → Environment
# 3. Add these variables in the Render dashboard:
#    - GEMINI_API_KEY (from Google AI Studio)
#    - JWT_SECRET_KEY (generate random: openssl rand -hex 32)
#    - DATABASE_PATH=/var/data/agents.db
#    - CHROMA_PERSIST_DIR=/var/data/chroma_db
#    - ALLOWED_ORIGINS=https://your-vercel-url.vercel.app
#    - ENVIRONMENT=production
#    - DEBUG=False
#
# For Local Development:
# 1. Copy this file to .env
# 2. Fill in your Gemini API key
# 3. Keep other values as defaults
# 4. Run: python backend/main.py
#
# Security Notes:
# - Never commit .env to git
# - Use strong JWT_SECRET_KEY (min 32 chars)
# - Check .gitignore includes .env
# - Rotate secrets regularly in production
# - Use Render dashboard for production secrets
# ═══════════════════════════════════════════════════════════════════

