{
  "buildCommand": "npm run build",
  "outputDirectory": "./dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://call-agent-smes.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_API_BASE_URL": "https://call-agent-smes.onrender.com"
  },
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "regions": ["sfo1"],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
